#!/bin/bash

sync_bars() {
    local outs=$1 open
    open=$(eww active-windows | cut -d: -f1)

    for o in $outs; do
        grep -qx "bar-$o" <<<"$open" || eww open bar --id "bar-$o" --arg screen="$o"
    done

    for w in $open; do
        case "$w" in
            bar-*) grep -qx "${w#bar-}" <<<"$outs" || eww close "$w" >/dev/null ;;
        esac
    done
}

niri msg -j event-stream |
    jq --unbuffered -r 'select(.WorkspacesChanged)
        | [.WorkspacesChanged.workspaces[].output] | unique | join(" ")' |
    while read -r outs; do
        sync_bars "${outs// /$'\n'}"
    done
