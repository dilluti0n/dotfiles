#!/bin/bash

set -u

case "${1:-}" in

workspaces)
	emit_workspaces() {
		niri msg --json workspaces 2>/dev/null | jq -c '
		sort_by(.output, .idx)
		| map({idx: .idx,
		       output: .output,
		       name: (if .name == null then (.idx|tostring) else .name end),
		       active: .is_active})' 2>/dev/null || echo '[]'
	}
	emit_workspaces
	niri msg --json event-stream | while IFS= read -r ev; do
		case "$ev" in
		*Workspace*) emit_workspaces ;;
		esac
	done
	;;

columns)
	niri msg -j event-stream | jq -cn --unbuffered '
	def key: tostring;
	foreach inputs as $e ({w: {}, o: null};
		.p = .o
		| if $e.WindowsChanged then
			.w = ($e.WindowsChanged.windows | map({key: (.id|key), value: .}) | from_entries)
		  elif $e.WindowOpenedOrChanged then
			($e.WindowOpenedOrChanged.window) as $x
			| (if $x.is_focused then .w |= map_values(.is_focused = false) else . end)
			| .w[$x.id|key] = $x
		  elif $e.WindowClosed then
			del(.w[$e.WindowClosed.id|key])
		  elif $e.WindowFocusChanged then
			($e.WindowFocusChanged.id) as $f
			| .w |= map_values(.is_focused = (.id == $f))
		  elif $e.WindowLayoutsChanged then
			reduce $e.WindowLayoutsChanged.changes[] as [$id, $l] (.;
				if .w[$id|key] then .w[$id|key].layout = $l else . end)
		  else . end
		| ([.w[] | select(.is_focused)][0]) as $fw
		| .o = (if $fw == null then [] else
			[.w[] | select(.workspace_id == $fw.workspace_id
				       and .layout.pos_in_scrolling_layout != null)]
			| group_by(.layout.pos_in_scrolling_layout[0])
			| map(sort_by(.layout.pos_in_scrolling_layout[1])
				| (map(select(.is_focused))[0] // .[0]) as $t
				| {i: (($t.app_id // "?") | split(".") | last | .[0:1] | ascii_upcase),
				  f: any(.is_focused)})
		  end);
		select(.o != .p) | .o)'
	;;

window)
	emit_window() {
		niri msg --json focused-window 2>/dev/null |
			jq -r 'if . == null then "" else (.title // "") end' 2>/dev/null || echo ''
	}
	emit_window
	niri msg --json event-stream | while IFS= read -r ev; do
		case "$ev" in
		*WindowFocusChanged* | *WindowOpenedOrChanged*) emit_window ;;
		esac
	done
	;;

mpris)
	US=$'\x1f'
	last=
	playerctl metadata -p playerctld -Ff "{{status}}${US}{{artist}}${US}{{title}}" 2>/dev/null |
		while IFS="$US" read -r status artist title; do
			case "$status" in
			Playing) out="$title" ;;
			Paused)	 out="P $title" ;;
			*)	 out='' ;;
			esac
			[ "$out" = "$last" ] && continue
			last=$out
			printf '%s\n' "$out"
		done
	;;

volume)
	emit_volume() {
		vol=$(pactl get-sink-volume @DEFAULT_SINK@ 2>/dev/null | awk 'NR==1 {print $5}')
		if [ "$(pactl get-sink-mute @DEFAULT_SINK@ 2>/dev/null | awk '{print $2}')" = "yes" ]; then
			echo "M $vol"
		else
			echo "V $vol"
		fi
	}
	emit_volume
	pactl subscribe 2>/dev/null | while IFS= read -r ev; do
		case "$ev" in
		*"on sink"*) emit_volume ;;
		esac
	done
	;;
net-listen)
	emit() {
		wlan=
		for d in /sys/class/net/*/wireless; do
			[ -e "$d" ] || continue
			wlan_if=$(basename "$(dirname "$d")")
			wlan=$(iw dev "$wlan_if" link 2>/dev/null | sed -n 's/^[[:space:]]*SSID: //p')
			break
		done

		eth= eth_if=
		for d in /sys/class/net/*; do
			eth_if=${d##*/}
			[ "$eth_if" = lo ] && continue
			[ -e "$d/wireless" ] && continue
			[ -e "$d/device" ] || continue
			{ read -r type < "$d/type"; } 2>/dev/null || continue
			[ "$type" = 1 ] || continue
			{ read -r state < "$d/operstate"; } 2>/dev/null || continue
			[ "$state" = up ] || continue
			eth="$eth_if"
			break
		done

		wgs=()
		for d in /sys/class/net/*; do
			[[ -e $d/uevent ]] || continue
			devtype=
			while read -r line; do
				[[ $line == DEVTYPE=* ]] && { devtype=${line#DEVTYPE=}; break; }
			done < "$d/uevent"
			[[ $devtype == wireguard ]] || continue
			wgs+=("${d##*/}")
		done
		wg="${wgs[*]}"

		rt= rt_if=
		read -r _ _ _ _ rt_if _ < <(ip route show default 2>/dev/null)
		if [[ -n $rt_if ]]; then
			if [[ $rt_if == "$wlan_if" ]]; then
				rt=wlan
			elif [[ $rt_if == "$eth_if" ]]; then
				rt=eth
			fi
		fi

		out=$(jq -cn --arg r "$rt" --arg w "$wlan" --arg e "$eth" --arg g "$wg" \
			 '{rt:$r,wlan:$w,eth:$e,wg:$g}')
		[ "$out" = "$last" ] && return
		last=$out
		printf '%s\n' "$out"
	}

	last=
	emit
	stdbuf -oL ip monitor link route 2>/dev/null | while read -r _; do emit; done
	;;
idle)
	case "$(cat /proc/$(pgrep -x swayidle)/stat 2>/dev/null | awk '{print $3}')" in
	T) echo "Idle off" ;;
	*) echo "Idle on" ;;
	esac
	;;
idle-toggle)
	p=$(pgrep -x swayidle) || exit 0
	case "$(awk '{print $3}' "/proc/$p/stat")" in
	T) kill -CONT "$p" ;;
	*) kill -STOP "$p" ;;
	esac
	eww update idle="$("$0" idle)"
	;;
volume-level)
	if [ "$(pactl get-sink-mute @DEFAULT_SINK@ 2>/dev/null | awk '{print $2}')" = "yes" ]; then
		echo 0
	else
		pactl get-sink-volume @DEFAULT_SINK@ 2>/dev/null |
			awk 'NR==1 {gsub(/%/,"",$5); print $5; exit}' || echo 0
	fi
	;;

osd)
	eww open volume-osd --duration 1.5s \
		--arg screen="$(niri msg -j focused-output | jq -r .name)"
	;;

*)
	echo "usage: eww-bar {workspaces|window|mpris|volume|net-listen|idle|idle-toggle|volume-level|osd}" >&2
	exit 1
	;;
esac
