#!/bin/sh

set -u

WLAN_IF=wlan0
ETH_IF=enp1s0f0
BAT=BAT0
STATE="${XDG_RUNTIME_DIR:-/tmp}/eww-bar"

mkdir -p "$STATE"

emit_workspaces() {
	niri msg --json workspaces 2>/dev/null | jq -c '
		sort_by(.output, .idx)
		| map({idx: .idx,
		       output: .output,
		       name: (if .name == null then (.idx|tostring) else .name end),
		       active: .is_active})' 2>/dev/null || echo '[]'
}

emit_window() {
	niri msg --json focused-window 2>/dev/null |
		jq -r 'if . == null then "" else (.title // "") end' 2>/dev/null || echo ''
}

case "${1:-}" in

workspaces)
	emit_workspaces
	niri msg --json event-stream | while IFS= read -r ev; do
		case "$ev" in
		*Workspace*) emit_workspaces ;;
		esac
	done
	;;

window)
	emit_window
	niri msg --json event-stream | while IFS= read -r ev; do
		case "$ev" in
		*Window* | *Workspace*) emit_window ;;
		esac
	done
	;;

mpris)
	if ! command -v playerctl >/dev/null 2>&1; then
		echo ''
		exec sleep infinity
	fi
	echo ''
	playerctl --follow --format '{{playerName}}|{{status}}' metadata 2>/dev/null |
		while IFS='|' read -r player status; do
			if [ -z "$player" ]; then
				echo ''
			elif [ "$status" = "Paused" ]; then
				echo "Mpris $player (PAUSED)"
			else
				echo "Mpris $player"
			fi
		done
	;;

volume)
	emit_volume() {
		if [ "$(pactl get-sink-mute @DEFAULT_SINK@ 2>/dev/null | awk '{print $2}')" = "yes" ]; then
			echo "Muted"
		else
			pactl get-sink-volume @DEFAULT_SINK@ 2>/dev/null |
				awk 'NR==1 {print "V " $5}'
		fi
	}
	emit_volume
	pactl subscribe 2>/dev/null | while IFS= read -r ev; do
		case "$ev" in
		*"on sink"*) emit_volume ;;
		esac
	done
	;;
net-listen)
	emit() {
		if [ -e "/sys/class/net/$WLAN_IF" ]; then
			ssid=$(iw dev "$WLAN_IF" link 2>/dev/null | sed -n 's/^[[:space:]]*SSID: //p')
			wlan=${ssid:-N/A}
		else
			wlan="N/A"
		fi

		if [ "$(cat "/sys/class/net/$ETH_IF/operstate" 2>/dev/null)" = "up" ]; then
			eth="$ETH_IF"
		else
			eth=""
		fi

		out=$(jq -cn --arg w "$wlan" --arg e "$eth" '{wlan:$w,eth:$e}')
		[ "$out" = "$last" ] && return
		last=$out
		printf '%s\n' "$out"
	}

	last=
	emit
	stdbuf -oL ip monitor link 2>/dev/null | while read -r _; do emit; done
	;;
idle)
	case "$(cat /proc/$(pgrep -x swayidle)/stat 2>/dev/null | awk '{print $3}')" in
	T) echo "Idle off" ;;
	*) echo "Idle on" ;;
	esac
	;;
idle-toggle)
	p=$(pgrep -x swayidle) || exit 0
	case "$(awk '{print $3}' "/proc/$p/stat")" in
	T) kill -CONT "$p" ;;
	*) kill -STOP "$p" ;;
	esac
	eww update idle="$("$0" idle)"
	;;
volume-level)
	if [ "$(pactl get-sink-mute @DEFAULT_SINK@ 2>/dev/null | awk '{print $2}')" = "yes" ]; then
		echo 0
	else
		pactl get-sink-volume @DEFAULT_SINK@ 2>/dev/null |
			awk 'NR==1 {gsub(/%/,"",$5); print $5; exit}' || echo 0
	fi
	;;

osd)
	eww open volume-osd --duration 1.5s \
		--arg screen="$(niri msg -j focused-output | jq -r .name)"
	;;

*)
	echo "usage: $0 {workspaces|window|mpris|volume|wlan|eth|cpu|mem|temp|battery|battery-time|idle|idle-toggle|volume-level|osd}" >&2
	exit 1
	;;
esac
