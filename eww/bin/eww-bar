#!/bin/bash

set -u

case "${1:-}" in

workspaces)
	emit_workspaces() {
		niri msg --json workspaces 2>/dev/null | jq -c '
		sort_by(.output, .idx)
		| map({idx: .idx,
		       output: .output,
		       name: (if .name == null then (.idx|tostring) else .name end),
		       active: .is_active})' 2>/dev/null || echo '[]'
	}
	emit_workspaces
	niri msg --json event-stream | while IFS= read -r ev; do
		case "$ev" in
		*Workspace*) emit_workspaces ;;
		esac
	done
	;;

window)
	emit_window() {
		niri msg --json focused-window 2>/dev/null |
			jq -r 'if . == null then "" else (.title // "") end' 2>/dev/null || echo ''
	}
	emit_window
	niri msg --json event-stream | while IFS= read -r ev; do
		case "$ev" in
		*Window* | *Workspace*) emit_window ;;
		esac
	done
	;;

mpris)
	if ! command -v playerctl >/dev/null 2>&1; then
		echo ''
		exec sleep infinity
	fi
	echo ''
	playerctl --follow --format '{{playerName}}|{{status}}' metadata 2>/dev/null |
		while IFS='|' read -r player status; do
			if [ -z "$player" ]; then
				echo ''
			elif [ "$status" = "Paused" ]; then
				echo "Mpris $player (PAUSED)"
			else
				echo "Mpris $player"
			fi
		done
	;;

volume)
	emit_volume() {
		if [ "$(pactl get-sink-mute @DEFAULT_SINK@ 2>/dev/null | awk '{print $2}')" = "yes" ]; then
			echo "Muted"
		else
			pactl get-sink-volume @DEFAULT_SINK@ 2>/dev/null |
				awk 'NR==1 {print "V " $5}'
		fi
	}
	emit_volume
	pactl subscribe 2>/dev/null | while IFS= read -r ev; do
		case "$ev" in
		*"on sink"*) emit_volume ;;
		esac
	done
	;;
net-listen)
	emit() {
		wlan=
		for d in /sys/class/net/*/wireless; do
			[ -e "$d" ] || continue
			wlan_if=$(basename "$(dirname "$d")")
			wlan=$(iw dev "$wlan_if" link 2>/dev/null | sed -n 's/^[[:space:]]*SSID: //p')
			break
		done

		eth= eth_if=
		for d in /sys/class/net/*; do
			eth_if=${d##*/}
			[ "$eth_if" = lo ] && continue
			[ -e "$d/wireless" ] && continue
			[ -e "$d/device" ] || continue
			{ read -r type < "$d/type"; } 2>/dev/null || continue
			[ "$type" = 1 ] || continue
			{ read -r state < "$d/operstate"; } 2>/dev/null || continue
			[ "$state" = up ] || continue
			eth="$eth_if"
			break
		done

		wgs=()
		for d in /sys/class/net/*; do
			[[ -e $d/uevent ]] || continue
			devtype=
			while read -r line; do
				[[ $line == DEVTYPE=* ]] && { devtype=${line#DEVTYPE=}; break; }
			done < "$d/uevent"
			[[ $devtype == wireguard ]] || continue
			wgs+=("${d##*/}")
		done
		wg="${wgs[*]}"

		rt= rt_if=
		read -r _ _ _ _ rt_if _ < <(ip route show default 2>/dev/null)
		if [[ -n $rt_if ]]; then
			if [[ $rt_if == "$wlan_if" ]]; then
				rt=wlan
			elif [[ $rt_if == "$eth_if" ]]; then
				rt=eth
			fi
		fi

		out=$(jq -cn --arg r "$rt" --arg w "$wlan" --arg e "$eth" --arg g "$wg" \
			 '{rt:$r,wlan:$w,eth:$e,wg:$g}')
		[ "$out" = "$last" ] && return
		last=$out
		printf '%s\n' "$out"
	}

	last=
	emit
	stdbuf -oL ip monitor link route 2>/dev/null | while read -r _; do emit; done
	;;
idle)
	case "$(cat /proc/$(pgrep -x swayidle)/stat 2>/dev/null | awk '{print $3}')" in
	T) echo "Idle off" ;;
	*) echo "Idle on" ;;
	esac
	;;
idle-toggle)
	p=$(pgrep -x swayidle) || exit 0
	case "$(awk '{print $3}' "/proc/$p/stat")" in
	T) kill -CONT "$p" ;;
	*) kill -STOP "$p" ;;
	esac
	eww update idle="$("$0" idle)"
	;;
volume-level)
	if [ "$(pactl get-sink-mute @DEFAULT_SINK@ 2>/dev/null | awk '{print $2}')" = "yes" ]; then
		echo 0
	else
		pactl get-sink-volume @DEFAULT_SINK@ 2>/dev/null |
			awk 'NR==1 {gsub(/%/,"",$5); print $5; exit}' || echo 0
	fi
	;;

osd)
	eww open volume-osd --duration 1.5s \
		--arg screen="$(niri msg -j focused-output | jq -r .name)"
	;;

*)
	echo "usage: eww-bar {workspaces|window|mpris|volume|net-listen|idle|idle-toggle|volume-level|osd}" >&2
	exit 1
	;;
esac
