;; -*- mode: lisp -*-

(deflisten all-workspaces :initial "[]" "eww-bar workspaces")
(deflisten window :initial "" "eww-bar window")
(deflisten mpris :initial "" "eww-bar mpris")
(deflisten volume :initial "" "eww-bar volume")
(deflisten net :initial "" "eww-bar net-listen")

(defpoll idle     :interval "5s"  :initial "Idle off" "eww-bar idle")

(defwidget workspaces [screen]
  (box :class "workspaces"
       (for ws in {jq(all-workspaces,'[.[] | select(.output == "' + screen + '")] | sort_by(.idx)')}
            (button :onclick "niri msg action focus-workspace ${ws.name}"
                    :class {ws.active ? "ws active" : "ws"}
                    "${ws.idx}"))))

(defwidget mpris []
  (box :class "mod mpris" :visible {mpris != ""}
       (label :text mpris :limit-width 25 :truncate true)))

(defwidget window []
  (label :class "mod window" :text window :limit-width 80 :truncate true))

(defwidget volume []
  (button :class "mod pulseaudio" :onclick "killall -q pavucontrol || pavucontrol &" volume))

(defwidget bzmenu []
  (button :class "mod bzmenu" :onclick "bzmenu -l bemenu &" "Bzmenu"))

(defwidget wlan []
  (button :class "mod network" :onclick "killall -q iwgtk || iwgtk &" {net.wlan}))

(defwidget eth []
  (box :class "mod network" :visible {net.eth != ""} (label :text {net.eth})))

(defwidget wg []
  (box :class "mod network" :visible {net.wg != ""} (label :text {net.wg})))

(defwidget cpu []  (label :class "mod cpu"  :text "${round(EWW_CPU.avg, 0)}%"))
(defwidget mem []  (label :class "mod memory" :text "${round(EWW_RAM.used_mem_perc, 0)}%"))
(defwidget temp []
  (tooltip
    (box :class "tt" :orientation "v" :space-evenly false
         (label :xalign 0 :text "CPU   ${EWW_TEMPS.THINKPAD_CPU}")
         (label :xalign 0 :text "GPU   ${EWW_TEMPS.AMDGPU_EDGE}")
         (label :xalign 0 :text "WiFi  ${EWW_TEMPS.ATH11K_HWMON_TEMP1}")
         (label :xalign 0 :text "SSD   ${round(EWW_TEMPS["NVME_COMPOSITE_WD_PC_SN740_SDDQNQD-1T00-1201_TEMP1"], 0)}"))
    (label :class {round(EWW_TEMPS.THINKPAD_CPU, 0) > 80 ? "mod temperature hot" : "mod temperature"}
           :text "${EWW_TEMPS.THINKPAD_CPU} °C")))

(defwidget battery []
  (label :class "mod battery"
         :text "${EWW_BATTERY?.BAT0?.status == 'Charging' ? 'C' : EWW_BATTERY?.BAT0?.status == 'Discharging' ? '' : 'P'} ${round(EWW_BATTERY?.BAT0?.capacity ?: 0, 0)}%"))

(defwidget idle []
  (button :class {idle == "Idle off" ? "mod idle activated" : "mod idle"}
          :onclick "eww-bar idle-toggle"
          idle))

(defwidget tray []
  (systray :class "mod tray" :icon-size 11 :spacing 8 :space-evenly false :prepend-new false))

(defwidget clock []
  (label :class "mod clock" :text {formattime(EWW_TIME, "%Y-%m-%d | %H:%M")}))

(defwidget left [screen]
  (box :space-evenly false :spacing 8 :halign "start"
       (workspaces :screen screen) (mpris)))

(defwidget center []
  (box :space-evenly false :halign "center"
       (window)))

(defwidget right []
  (box :space-evenly false :spacing 8 :halign "end"
       (volume) (wg) (wlan) (eth) (cpu) (mem) (temp) (battery) (idle) (tray) (clock)))

(defwidget bar-content [screen]
  (centerbox :class "bar" :orientation "h"
             (left :screen screen) (center) (right)))

(defwindow bar [screen]
  :monitor screen
  :geometry (geometry :x "0" :y "0" :width "100%" :height "18px" :anchor "top center")
  :stacking "fg"
  :exclusive true
  :namespace "eww-bar"
  (bar-content :screen screen))
