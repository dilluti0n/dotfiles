defaults
auth           on
tls            on
tls_trust_file /etc/ssl/certs/ca-certificates.crt
logfile        ~/.msmtp.log

account fastmail-gmail
host smtp.fastmail.com
port 587
from hskimse1@gmail.com
user hskim@dilluti0n.com
passwordeval "pass show hskim/fastmail.com | awk '/^app-password-eps:/ {print $2}'"

account smtp2go
host mail.smtp2go.com
port 2525
user dilluti0n.com
passwordeval "pass show hskim/smtp2go.com | awk '/^app-password:/ {print $2}'"

account alpha
host alpha
port 587
from hskim@dilluti0n.com
allow_from_override off
tls off
auth off

account default : alpha
